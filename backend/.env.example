# =============================================================================
# PENTA PRIZM BACKEND — RENDER ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Server Port and Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS & Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# Shared Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Rate Limiting & Security (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
