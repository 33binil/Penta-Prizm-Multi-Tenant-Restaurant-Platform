# =============================================================================
# PENTA PRIZM FRONTEND — VERCEL ENVIRONMENT CONFIGURATION (.env.example)
# =============================================================================

# Backend REST API URL (Render Web Service)
# In local development: http://localhost:3000/api or /api
VITE_API_URL=https://your-backend.onrender.com/api

# Public Supabase Client (Only public anon key, never service-role key!)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
